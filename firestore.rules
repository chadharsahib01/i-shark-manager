rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().active == true;
    }

    function isAdmin() {
      return hasActiveProfile() && userDoc().role == 'admin';
    }

    function isAssignedToMe() {
      return resource.data.assignedTo == 'all'
        || (resource.data.assignedStudentIds is list
            && request.auth.uid in resource.data.assignedStudentIds);
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 150
        && data.name is string && data.name.size() <= 100
        && data.role in ['admin', 'student']
        && data.active is bool;
    }

    function isValidAttendance(data) {
      return data.id is string
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.studentId is string && data.studentId.size() <= 128
        && data.status in ['Present', 'Late', 'Absent', 'Leave'];
    }

    function isValidTask(data) {
      return data.id is string
        && data.title is string && data.title.size() <= 150
        && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.assignedTo in ['all', 'selected'];
    }

    function isValidTest(data) {
      return data.id is string
        && data.title is string && data.title.size() <= 150
        && data.type in ['Quiz', 'Test', 'Exam', 'Midterm', 'Final']
        && data.subject is string && data.subject.size() <= 100
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() <= 25
        && data.assignedTo in ['all', 'selected'];
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin()
        || (hasActiveProfile() && resource.data.studentId == request.auth.uid);
      allow create, update: if isAdmin() && isValidAttendance(request.resource.data);
      allow delete: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if isAdmin() || (hasActiveProfile() && isAssignedToMe());
      allow create, update: if isAdmin() && isValidTask(request.resource.data);
      allow delete: if isAdmin();
    }

    match /tests/{id} {
      allow read: if isAdmin() || (hasActiveProfile() && isAssignedToMe());
      allow create, update: if isAdmin() && isValidTest(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
