rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hacker.chadhar@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStudent(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helpers
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 150 &&
        (
          (data.name is string && data.name.size() <= 100) ||
          (data.fullName is string && data.fullName.size() <= 100)
        ) &&
        data.role in ['admin', 'student'] &&
        (
          data.active is bool ||
          data.isActive is bool
        );
    }

    function isValidAttendance(data) {
      return data.id is string &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.status in ['Present', 'Late', 'Absent', 'Leave'];
    }

    function isValidTask(data) {
      return data.id is string &&
        data.title is string && data.title.size() <= 150 &&
        data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.assignedTo in ['all', 'selected'];
    }

    function isValidTest(data) {
      return data.id is string &&
        data.title is string && data.title.size() <= 150 &&
        data.type in ['Quiz', 'Test', 'Exam', 'Midterm', 'Final'] &&
        data.subject is string && data.subject.size() <= 100 &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() <= 25 &&
        data.assignedTo in ['all', 'selected'];
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(request.resource.data) && (isAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && isValidUser(request.resource.data) && (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && isValidAttendance(request.resource.data);
      allow update: if isAdmin() && isValidAttendance(request.resource.data);
      allow delete: if isAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.assignedTo == 'all' ||
        (resource.data.assignedStudentIds is list && request.auth.uid in resource.data.assignedStudentIds)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.assignedTo == 'all' ||
        (resource.data.assignedStudentIds is list && request.auth.uid in resource.data.assignedStudentIds)
      );
      allow create: if isAdmin() && isValidTask(request.resource.data);
      allow update: if isAdmin() && isValidTask(request.resource.data);
      allow delete: if isAdmin();
    }

    // Tests/Quizzes Collection
    match /tests/{testId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.assignedTo == 'all' ||
        (resource.data.assignedStudentIds is list && request.auth.uid in resource.data.assignedStudentIds)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.assignedTo == 'all' ||
        (resource.data.assignedStudentIds is list && request.auth.uid in resource.data.assignedStudentIds)
      );
      allow create: if isAdmin() && isValidTest(request.resource.data);
      allow update: if isAdmin() && isValidTest(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
